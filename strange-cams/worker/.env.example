# Supabase (Project Settings → API). La clé service_role reste côté serveur, JAMAIS dans l'app.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stockage des clips : bucket S3-compatible (Cloudflare R2 recommandé).
# Sans S3_BUCKET, les clips sont écrits dans DATA_DIR/media (développement uniquement).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=strange-cams-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=https://media.example.com

# Dossier de travail (historique d'images, anneau HLS). Prévoir ~2 Go.
DATA_DIR=./data
# Contact envoyé dans le User-Agent aux serveurs des institutions (bonne pratique).
INGEST_CONTACT=contact@example.com

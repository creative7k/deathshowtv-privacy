# Supabase (Project Settings → API). La clé service_role reste sur la machine du worker, JAMAIS dans l'app.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Par défaut (gratuit) : les clips vont dans le stockage Supabase du projet (bucket « media », 1 Go).
# Durée de conservation des clips, pour rester sous le quota gratuit.
CLIP_RETENTION_DAYS=3

# Dossier de travail (historique d'images, anneau HLS). Prévoir ~2 Go.
DATA_DIR=./data
# Contact envoyé dans le User-Agent aux serveurs des institutions (bonne pratique).
INGEST_CONTACT=

# Le flux CHP passe par l'Edge Function « chp-feed » (exécutée en Californie), car la CHP bloque
# les connexions hors des États-Unis. Mettre true si le worker tourne aux États-Unis.
CHP_DIRECT=false

# Option payante, plus tard : bucket S3-compatible (Cloudflare R2…). Laisser vide pour rester gratuit.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=
